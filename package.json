{
  "name": "memento-agent",
  "version": "0.3.0",
  "description": "Spec-driven coding agent with persistent memory. Every session makes it smarter; every spec stays alive.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YanXich/memento.git"
  },
  "homepage": "https://github.com/YanXich/memento#readme",
  "bugs": {
    "url": "https://github.com/YanXich/memento/issues"
  },
  "author": "memento contributors",
  "engines": {
    "node": ">=20.10.0"
  },
  "bin": {
    "memento": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "demo": "node scripts/demo.mjs",
    "stress:memory": "node scripts/stress-memory.mjs",
    "prepublishOnly": "npm run build",
    "merge-bench": "node scripts/merge-bench.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "ai-coding",
    "agentic",
    "spec-driven-development",
    "sdd",
    "memory",
    "learning",
    "mcp",
    "benchmark",
    "llm",
    "cli",
    "terminal",
    "deepseek",
    "openai",
    "anthropic",
    "ollama",
    "developer-tools",
    "typescript"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "jiti": "^2.4.2",
    "picocolors": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
